# Copier ce fichier en `.env` et adapter les valeurs.
# Aucune valeur réelle ne doit être committée.

# --- Django ---
# Obligatoire hors développement local.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Durée des jetons d'accès pour les exercices, ignorée hors DJANGO_DEBUG=True.
JWT_DEV_ACCESS_MINUTES=20

# --- PostgreSQL ---
POSTGRES_DB=afrimyth
POSTGRES_USER=afrimyth
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
