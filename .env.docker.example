# Copier ce fichier en `.env.docker`, puis remplacer les valeurs.
# `.env.docker` est ignoré par Git et n'entre jamais dans l'image.
#
# Ce fichier est **distinct** du `.env` des exercices : les deux installations
# ne partagent aucun secret, et les conteneurs n'utilisent jamais le `.env`
# local. Les valeurs ci-dessous sont fictives.

# --- Django ---
# Remplacer par une valeur aléatoire propre à cette installation.
DJANGO_SECRET_KEY=fictitious-docker-only-key-replace-me
# Serveur de développement : `True` est attendu pour ce lot local. Il permet
# aussi à `runserver` de servir les fichiers statiques de l'administration.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
JWT_DEV_ACCESS_MINUTES=20

# --- PostgreSQL ---
# Lues par les deux services : le conteneur PostgreSQL crée cette base et ce
# rôle au premier démarrage, l'API s'y connecte avec les mêmes valeurs.
# `POSTGRES_HOST` n'est pas ici : `docker-compose.yml` impose le nom du
# service `db`, pour qu'aucune configuration ne puisse viser `localhost`.
POSTGRES_DB=afrimyth
POSTGRES_USER=afrimyth
POSTGRES_PASSWORD=fictitious-local-password-replace-me
